# ====== DATABASE ======
DATABASE_URL="postgresql://hafalanku_user:hafalanku_password@localhost:5432/hafalanku?schema=public"
MONGODB_URL="mongodb://localhost:27017/hafalanku"
REDIS_URL="redis://localhost:6379"

# ====== AUTH ======
JWT_SECRET="your-jwt-secret-min-32-chars-here-replace-in-production"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# ====== ENCRYPTION ======
APP_SECRET="your-aes-256-secret-key-min-32-chars-replace-in-production"

# ====== TELEGRAM BOT ======
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="-1001234567890"

# ====== APP ======
FRONTEND_URL="http://localhost:3000"
BACKEND_PORT=4000
NODE_ENV="development"

# ====== FILE UPLOAD ======
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=2097152  # 2MB in bytes

# ====== DOCKER SPECIFIC ======
PG_PASSWORD=hafalanku_password
